# ---------------------------------------------------------------------------
# Anaj Bahi — Firebase config (Phase 6+). Copy to `.env.local` and fill in.
# `.env.local` is gitignored; NEVER commit it.
#
# The 6 NEXT_PUBLIC_FIREBASE_* values are PUBLIC Firebase Web config (safe to
# ship in the client bundle) — real security is enforced by Firestore Rules.
# Get them from: Firebase Console -> Project settings -> Your apps -> Web app -> SDK config.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Emulator toggle (E2E / optional local dev). When 'true' (or '1'), the app
# points Auth + Firestore at the local Firebase emulators (Auth 9099, Firestore
# 8080 — see firebase.json). Google sign-in is then simulated by the Auth
# emulator's built-in test-IdP popup (no real Google account, no network).
# Default (unset / 'false') -> real Firebase. Playwright sets this to '1'.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=false

# ---------------------------------------------------------------------------
# Auth is Google sign-in (GoogleAuthProvider + signInWithPopup), free on the
# Spark plan. There is NO phone/SMS/OTP and NO reCAPTCHA. There is NO service
# account and NO FIREBASE_SERVICE_ACCOUNT secret: E2E runs against the emulators
# and the Firestore emulator is reset via its REST endpoint, so firebase-admin
# is not required.
#
# Console prerequisites (real project only, out-of-band — see DEPLOY.md):
#   - Authentication -> Sign-in method -> enable Google (with a support email)
#   - Authentication -> Settings -> Authorized domains -> add your Pages host
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Bill Check — Gemini API key (Phase 13). OPTIONAL: leave empty and the rest of
# the app works exactly as before; the Check-a-bill screen then shows a labelled
# "not set up yet" panel instead of crashing.
#
# !! THIS KEY IS PUBLIC !!  NEXT_PUBLIC_* values are inlined into the JavaScript
# bundle, so anyone who opens devtools on the deployed site can read this key and
# spend against it. This is NOT the same as the NEXT_PUBLIC_FIREBASE_* values
# above: those are designed to be public and are guarded by Firestore Rules,
# whereas a Gemini key is a billable credential with no server-side guard.
#
# Shipping it this way was a deliberate trade-off to avoid standing up a proxy
# before the trader pilot (see spec/architecture.md "Bill Check" for the full
# reasoning and the migration path to a Cloudflare Worker).
#
# Therefore, before you put a real key here:
#   1. Use a DEDICATED key, used for nothing else, so revoking it breaks nothing.
#   2. Restrict it by HTTP referrer to your Pages origin (Google Cloud console ->
#      APIs & Services -> Credentials -> your key -> Website restrictions).
#   3. Set a HARD QUOTA CAP on it, so the worst case is a dead feature and never
#      an unbounded bill.
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GEMINI_API_KEY=

# Model used to read the bill photo. Default (when unset) is
# `gemini-flash-lite-latest` — the job is transcription, not reasoning, and cost
# scales with bills/day. Overridable so the accuracy bake-off (20 real bills,
# scored on CONFIDENT-AND-WRONG rate, not raw accuracy) needs no code change.
NEXT_PUBLIC_GEMINI_MODEL=
